{
  "name": "playwright-quality-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Playwright + TypeScript quality framework with a production guard, TC traceability and bug drafting. Reference app: QA Practice.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tc:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tc-validate.ts",
    "ai:guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-guard.ts",
    "test": "playwright test",
    "test:framework": "playwright test --project=framework",
    "test:smoke": "playwright test --project=qa-practice-chromium --grep @smoke",
    "test:qa-practice": "playwright test --project=qa-practice-chromium --project=qa-practice-mobile",
    "test:cross-browser": "playwright test --project=qa-practice-firefox --project=qa-practice-webkit",
    "report": "playwright show-report \"$(head -1 evidence/latest)/html\"",
    "check": "npm run typecheck && npm run lint && npm run tc:validate && npm run privacy:check && npm run test:framework",
    "evidence:plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evidence-retention.ts",
    "evidence:prune": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evidence-retention.ts --apply",
    "evidence:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evidence-retention.ts --verify",
    "privacy:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/privacy-check.ts",
    "evidence:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evidence-export.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "zod": "4.6.7"
  }
}
